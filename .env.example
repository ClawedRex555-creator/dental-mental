# Copy to .env and fill in values: cp .env.example .env
# Generate secrets: openssl rand -base64 48

# Required — session HMAC (never reuse PHI or TLS secrets)
AUTH_SECRET=

# Required — production domain (e.g. emkaro.ru)
APP_ROOT_DOMAIN=emkaro.ru

# Required — PostgreSQL password for docker-compose
POSTGRES_PASSWORD=

# Required — AES-256-GCM for patient PHI at rest (do not rotate without migration)
PHI_ENCRYPTION_KEY=

# Optional — only if experimenting with on_demand_tls (not used by default Caddyfile)
# TLS_ASK_SECRET=

# Let's Encrypt contact
ACME_EMAIL=admin@emkaro.ru

# Must stay false in production (app fails startup if true with NODE_ENV=production)
ENABLE_DEMO_ACCOUNTS=false

# Optional — platform superadmin
SUPERADMIN_LOGIN=
SUPERADMIN_PASSWORD=

# Optional — лендинг emkaro.ru: переопределение адреса ИП и счётчик Метрики
# NEXT_PUBLIC_EMKARO_OPERATOR_ADDRESS=346720, Ростовская обл., Аксайский р-н, г. Аксай, ул. Луначарского, 253/65
# NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Optional — EGISZ integration (EGISZ_SYSTEM_ID не нужен: N3 определяет МИС автоматически)
EGISZ_GATEWAY_URL=
EGISZ_ENV=test
EGISZ_PRODUCT_NAME=Emkaro
EGISZ_N3_STUB=true
EGISZ_CRON_SECRET=
EGISZ_WEBHOOK_SECRET=
# Агент КриптоПро на Windows-ПК (см. docs/CRYPTOPRO-WINDOWS.md)
EGISZ_SIGNING_URL=
EGISZ_SIGNING_SECRET=

# Optional — уведомления пациентов о записи (cron + провайдеры)
NOTIFICATIONS_CRON_SECRET=
APP_PUBLIC_BASE_URL=
NOTIFICATIONS_MOCK_FAIL=0
NOTIFICATIONS_TELEGRAM_BOT_TOKEN=
NOTIFICATIONS_WHATSAPP_ACCESS_TOKEN=
NOTIFICATIONS_WHATSAPP_PHONE_NUMBER_ID=
NOTIFICATIONS_WHATSAPP_API_URL=
NOTIFICATIONS_SMS_API_URL=
NOTIFICATIONS_SMS_API_KEY=
NOTIFICATIONS_SMS_SENDER=
NOTIFICATIONS_SMTP_URL=
NOTIFICATIONS_SMTP_API_KEY=
NOTIFICATIONS_EMAIL_FROM=
NOTIFICATIONS_VK_ACCESS_TOKEN=
NOTIFICATIONS_MAX_API_TOKEN=
