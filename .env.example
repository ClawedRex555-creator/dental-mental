# Copy to .env and fill in values: cp .env.example .env
# Generate secrets: openssl rand -base64 48

# Required — session HMAC (never reuse PHI or TLS secrets)
AUTH_SECRET=

# Required — production domain (e.g. emkaro.ru)
APP_ROOT_DOMAIN=emkaro.ru

# Required — PostgreSQL password for docker-compose
POSTGRES_PASSWORD=

# Required — AES-256-GCM for patient PHI at rest (do not rotate without migration)
PHI_ENCRYPTION_KEY=

# Optional — only if experimenting with on_demand_tls (not used by default Caddyfile)
# TLS_ASK_SECRET=

# Let's Encrypt contact
ACME_EMAIL=admin@emkaro.ru

# Must stay false in production (app fails startup if true with NODE_ENV=production)
ENABLE_DEMO_ACCOUNTS=false

# Optional — platform superadmin
SUPERADMIN_LOGIN=
SUPERADMIN_PASSWORD=

# Optional — подсказки адресов (DaData Suggest). Без токена работают
# только подсказки из уже сохранённых адресов пациентов в клинике.
# Токен: https://dadata.ru → API → API-ключ (Token …)
DADATA_API_TOKEN=

# Optional — лендинг emkaro.ru: переопределение адреса ИП и счётчик Метрики
# NEXT_PUBLIC_EMKARO_OPERATOR_ADDRESS=346720, Ростовская обл., Аксайский р-н, г. Аксай, ул. Луначарского, 253/65
# NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Optional — EGISZ integration (EGISZ_SYSTEM_ID не нужен: N3 определяет МИС автоматически)
EGISZ_GATEWAY_URL=
EGISZ_ENV=test
EGISZ_PRODUCT_NAME=Emkaro
EGISZ_N3_STUB=true
EGISZ_CRON_SECRET=
EGISZ_WEBHOOK_SECRET=
# Агент КриптоПро на Windows-ПК (см. docs/CRYPTOPRO-WINDOWS.md)
EGISZ_SIGNING_URL=
EGISZ_SIGNING_SECRET=

# Cron уведомлений (обязателен для notifications-cron; не используйте AUTH_SECRET)
NOTIFICATIONS_CRON_SECRET=

# MedFlex / ПроДокторов: автовыгрузка расписания (medflex-cron каждые 15 мин).
# Если пусто — используется EGISZ_CRON_SECRET.
MEDFLEX_CRON_SECRET=
APP_PUBLIC_BASE_URL=
NOTIFICATIONS_MOCK_FAIL=0
NOTIFICATIONS_TELEGRAM_BOT_TOKEN=
NOTIFICATIONS_WHATSAPP_ACCESS_TOKEN=
NOTIFICATIONS_WHATSAPP_PHONE_NUMBER_ID=
NOTIFICATIONS_WHATSAPP_API_URL=
NOTIFICATIONS_SMS_API_URL=
NOTIFICATIONS_SMS_API_KEY=
NOTIFICATIONS_SMS_SENDER=
NOTIFICATIONS_SMTP_URL=
NOTIFICATIONS_SMTP_API_KEY=
NOTIFICATIONS_EMAIL_FROM=
NOTIFICATIONS_VK_ACCESS_TOKEN=
NOTIFICATIONS_MAX_API_TOKEN=

# Web Push (опционально: если не задано — ключи создаются автоматически в БД)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@emkaro.ru

# Подпись документов: emkaro (свой SMS + /sign), emkaro_sign (sign.emkaro.ru) или fdoc (REST F.Doc)
DOCUMENT_SIGN_PROVIDER=emkaro

# Emkaro Sign — внешний сервис подписи; SMS вручную с телефона клиники (не SMS-провайдер МИС)
# Production:
# DOCUMENT_SIGN_PROVIDER=emkaro_sign
# EMKARO_SIGN_API_URL=https://sign.emkaro.ru
# EMKARO_SIGN_API_KEY=…              # = INTEGRATION_API_KEY в Sign /.env.production
# EMKARO_SIGN_WEBHOOK_SECRET=…       # = EMKARO_WEBHOOK_SECRET в Sign
# EMKARO_SIGN_TENANT_MAP={"tstom":{"organizationId":"…","clinicId":"…"}}
# Local:
# EMKARO_SIGN_API_URL=http://localhost:43123
# EMKARO_SIGN_API_KEY=dev-integration-api-key
# Привязку можно также задать в clinics.emkaro_sign_config (organizationId, clinicId)
# В Sign: EMKARO_URL=https://emkaro.ru  (webhooks → /api/webhooks/emkaro-sign)
# Только non-production: EMKARO_SIGN_MOCK=1
# Bootstrap tenant on Sign VPS: bash scripts/bootstrap-tenant-for-mis.sh


# F.Doc — после заявки https://fdoc.ru/integration/api/
# FDOC_API_URL=https://…
# FDOC_API_KEY=
# FDOC_LOGIN=
# FDOC_PASSWORD=
# FDOC_WEBHOOK_SECRET=
# FDOC_EMPLOYEE_ID=
# FDOC_TEST_MODE=0
# FDOC_CRON_SECRET=
