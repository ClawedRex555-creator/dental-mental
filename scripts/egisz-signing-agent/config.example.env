# Скопируйте в C:\emkaro-signing\config.env и заполните.
# Используется run-agent.ps1 и run-tunnel.ps1

# Секрет — тот же, что EGISZ_SIGNING_SECRET в /opt/emkaro/.env на сервере
EGISZ_SIGNING_SECRET=замените-на-длинный-секрет

EGISZ_SIGNING_PORT=9876

# Путь к csptest (CSP 5.0) или cryptcp
CRYPTOPRO_CSPTEST=C:\Program Files (x86)\Crypto Pro\CSP\csptest.exe

# SSH-туннель на сервер Emkaro (подпись для Docker)
EMKARO_SSH_HOST=root@201.51.0.171
EMKARO_SSH_PORT=22
# Локальный порт агента -> проброс на сервер 127.0.0.1:9876
TUNNEL_LOCAL_PORT=9876
TUNNEL_REMOTE_PORT=9876
